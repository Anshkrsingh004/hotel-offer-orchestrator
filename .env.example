# Copy to .env for local (non-Docker) runs. Docker Compose sets its own values.

# Express API
API_PORT=3000

# Where Temporal activities reach the mock suppliers.
# Local: http://localhost:3000  |  Docker worker: http://api:3000
SUPPLIER_BASE_URL=http://localhost:3000

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-orchestrator

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# Image versions used by docker-compose
TEMPORAL_VERSION=1.25.2
TEMPORAL_UI_VERSION=2.34.0
