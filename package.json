{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregate overlapping hotel offers from two mock suppliers, dedupe by name, and pick the best-priced offer per hotel. Orchestrated with Temporal, backed by Redis.",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ts-node/register --test src/domain/dedupe.test.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "ts-node src/api/server.ts",
    "dev:worker": "ts-node src/temporal/worker.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "temporal",
    "redis",
    "express",
    "typescript",
    "orchestration"
  ],
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "express": "^4.21.2",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
